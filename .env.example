# YouTube Data API v3 (server only)
YOUTUBE_API_KEY=

# Firebase public client configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase service account used by next-firebase-auth-edge (server only)
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Signed application cookie
AUTH_COOKIE_NAME=youtuber-ai-auth
AUTH_COOKIE_SIGNATURE_KEY_CURRENT=
AUTH_COOKIE_SIGNATURE_KEY_PREVIOUS=
USE_SECURE_COOKIES=false

# Google Vertex AI (server only)
# Application Default Credentials are supported when only the project/location are set.
VERTEX_PROJECT_NAME=
VERTEX_LOCATION=global
VERTEX_MODEL=gemini-3.5-flash

# Optional explicit service-account fields
VERTEX_AUTH_EMAIL=
VERTEX_AUTH_CLIENT_ID=
VERTEX_AUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative: base64-encoded service-account JSON
GOOGLE_SERVICE_KEY=
